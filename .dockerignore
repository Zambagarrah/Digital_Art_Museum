# Build context hygiene. Anything listed here never reaches the Docker daemon,
# which keeps builds fast and stops local secrets from landing in an image.

.git
.gitignore
node_modules
.next
out
build

# Regenerated inside the image for the correct platform.
src/generated

# Local secrets and databases.
.env
.env.*
!.env.example
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# Tooling and docs that play no part in the build.
.qodo
.vscode
README.md
AGENTS.md
CLAUDE.md
Dockerfile
.dockerignore
compose.yaml
npm-debug.log*
*.tsbuildinfo
.DS_Store
