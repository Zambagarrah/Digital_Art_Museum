# Local development. Matches the Postgres service in compose.yaml:
#   docker compose up -d
DATABASE_URL="postgresql://museum:museum@localhost:5432/digital_art_museum"

# In production, point this at the Postgres service. On Dokploy, use the
# internal hostname shown on the database's page — the container is on the same
# Docker network, so no port needs to be published:
# DATABASE_URL="postgresql://museum:password@museum-db:5432/digital_art_museum"
